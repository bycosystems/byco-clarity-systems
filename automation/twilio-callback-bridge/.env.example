# Copie ce fichier en ".env" (jamais commite, deja dans .gitignore).
#
# ACCOUNT_SID / AUTH_TOKEN (ou API_KEY / API_SECRET) servent uniquement a
# authentifier le deploiement + le script de test depuis cette machine.
# Les variables suivantes (STUDIO_FLOW_SID, SAMUEL_NUMBER, TWILIO_NUMBER,
# CALLBACK_SHARED_SECRET) sont celles reellement utilisees par la Function
# une fois deployee (twilio-run les pousse comme Environment Variables du
# Service).

ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option recommandee : cle API restreinte (Console > Account > API keys &
# tokens > Create API Key, scope Voice + Studio) plutot que l'Auth Token
# principal du compte.
# Si tu utilises une API Key : renseigne API_KEY_SID/API_KEY_SECRET et laisse
# AUTH_TOKEN vide. Si tu preferes l'Auth Token principal, renseigne AUTH_TOKEN
# et laisse les deux autres vides.
AUTH_TOKEN=
API_KEY_SID=
API_KEY_SECRET=

STUDIO_FLOW_SID=FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAMUEL_NUMBER=+33600000000
TWILIO_NUMBER=+447576594092

# Genere une chaine aleatoire longue, ex (PowerShell) :
# -join ((48..57)+(97..102)|Get-Random -Count 40|%{[char]$_})
CALLBACK_SHARED_SECRET=

# --- Reception WebRTC du premier leg (Voice SDK) ---
# Identite du Client WebRTC de Samuel. Doit etre la meme valeur des deux
# cotes (callback-bridge.js s'en sert pour cibler "client:<identity>",
# voice-token.js s'en sert pour generer le token de cette identite).
VOICE_CLIENT_IDENTITY=samuel

# API Key dediee a la generation d'Access Tokens (Console > Account > API
# keys & tokens > Create API key > type **Standard**, PAS Restricted : les
# cles Restricted ne peuvent pas signer d'Access Tokens). Peut etre distincte
# de celle utilisee pour le deploiement (API_KEY_SID/API_KEY_SECRET
# ci-dessus).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Utilise uniquement par scripts/test-bridge.js : numero de test pour la
# "prospect leg". Laisse egal a SAMUEL_NUMBER pour un test moi-vers-moi
# (recommande si tu n'as pas de second numero sous la main), ou mets un
# second numero qui t'appartient.
TEST_PROSPECT_NUMBER=+33600000000

# Utilise uniquement par scripts/test-bridge.js : mode du premier leg pour ce
# test ("pstn" ou "webrtc"). Laisse a "pstn" par defaut — ce script n'a pas de
# navigateur pour recevoir un appel WebRTC ; le test webrtc se fait depuis
# call-page.html elle-meme, avec le navigateur de Samuel ouvert et enregistre.
TEST_MODE=pstn

# Rempli automatiquement apres "npm run deploy" (URL de la Function
# deployee) - ou colle-la toi-meme depuis la sortie du deploiement.
FUNCTION_URL=
